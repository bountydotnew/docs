{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "bounty.new",
  "colors": {
    "primary": "#191919",
    "light": "#ffffff",
    "dark": "#2f2e2e"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "introduction",
          "guides/creating-bounties"
        ]
      },
      {
        "group": "For creators",
        "pages": [
          "guides/creating-bounties",
          "guides/funding-bounties"
        ]
      },
      {
        "group": "For developers",
        "pages": [
          "guides/solving-bounties",
          "guides/getting-paid"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/discord",
          "integrations/github",
          "integrations/linear"
        ]
      },
      "introduction"
    ]
  },
  "logo": "/logo/dark.png",
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@bounty.new"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://bounty.new/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/bountydotnew",
      "github": "https://github.com/bountynew"
    }
  },
  "background": {
    "color": {
      "dark": "#0e0e0e"
    },
    "decoration": "gradient"
  },
  "appearance": {
    "strict": true,
    "default": "dark"
  },
  "font": {
    "headings": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    },
    "code": {
      "family": "monospace"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "thumbnails": {
    "appearance": "dark"
  }
}